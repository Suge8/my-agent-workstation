{
  "name": "my-agent-workstation",
  "version": "0.3.0",
  "private": true,
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["packages/firecode/index.ts"],
    "skills": ["packages/skills"]
  },
  "scripts": {
    "test": "bun test --timeout 90000 tests/asset-integrity.test.ts tests/sync-sources.test.ts packages/firecode/tests",
    "test:sync": "bun test --timeout 30000 tests/asset-integrity.test.ts tests/sync-sources.test.ts",
    "test:pi-smoke": "bun test --timeout 15000 packages/firecode/provider/openai-native/test/pi-smoke.test.ts",
    "test:bcu": "npm --prefix packages/better-computer-use test",
    "sync": "node scripts/sync-sources.mjs"
  }
}
