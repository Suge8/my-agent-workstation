# Ghostty 配置，落点 ~/.config/ghostty/config。

# ---- Font ---------------------------------------------------------------------
# Maple covers Latin and Nerd Font icons; OPPO Sans fills in CJK.
font-family = Maple Mono NF
font-family = OPPO Sans 4.0
font-family-italic = Maple Mono NF
font-family-bold-italic = Maple Mono NF
font-size = 12
adjust-cell-height = -10%
font-feature = calt
font-feature = liga
font-feature = dlig

# ---- Theme --------------------------------------------------------------------
theme = dark:Monokai Vivid,light:GitHub
window-theme = system
alpha-blending = linear-corrected
window-colorspace = display-p3
window-vsync = true
custom-shader = ~/.config/ghostty/shaders/cursor.frag

# ---- Window -------------------------------------------------------------------
macos-option-as-alt = true
macos-titlebar-style = hidden
macos-shortcuts = ask
window-save-state = always
window-inherit-working-directory = true
focus-follows-mouse = true
confirm-close-surface = true
unfocused-split-opacity = 0.8

# ---- Mouse & cursor -----------------------------------------------------------
cursor-style = block
cursor-click-to-move = true
mouse-scroll-multiplier = precision:1,discrete:1
mouse-hide-while-typing = true
mouse-shift-capture = never

# ---- Clipboard ----------------------------------------------------------------
copy-on-select = clipboard
right-click-action = copy-or-paste
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true
clipboard-read = allow
clipboard-write = allow

# ---- Scrollback ---------------------------------------------------------------
scroll-to-bottom = keystroke,no-output
scrollback-limit = 134217728

# ---- Integration --------------------------------------------------------------
shell-integration = detect
desktop-notifications = true
link-previews = true
bell-features = attention

# ---- Keybinds -----------------------------------------------------------------
# Pi: LF inserts a real newline instead of submitting the prompt.
keybind = shift+enter=text:\n

# Herdr's default prefix is Ctrl+B (\x02). Cmd bindings send the prefix and action together.
keybind = super+n=text:\x02N
keybind = super+t=text:\x02c
keybind = super+w=text:\x02x
keybind = super+alt+w=text:\x02X
keybind = super+d=text:\x02v
keybind = super+shift+d=text:\x02-
keybind = super+alt+h=text:\x02h
keybind = super+alt+j=text:\x02j
keybind = super+alt+k=text:\x02k
keybind = super+alt+l=text:\x02l
keybind = super+shift+enter=text:\x02z

# Ghostty utilities. Cmd+F and Cmd+Shift+W intentionally remain defaults.
keybind = super+,=open_config
keybind = super+shift+,=reload_config
keybind = super+z=undo
keybind = super+shift+z=redo
keybind = super+alt+f=write_scrollback_file:open
keybind = super+shift+up=jump_to_prompt:-1
keybind = super+shift+down=jump_to_prompt:1

# ---- Quick terminal -----------------------------------------------------------
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-size = 35%
quick-terminal-animation-duration = 0.12
keybind = global:super+grave_accent=toggle_quick_terminal
