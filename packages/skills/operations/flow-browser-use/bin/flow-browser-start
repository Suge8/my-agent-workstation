#!/usr/bin/env bash
set -euo pipefail

# Flow Browser launches a DEDICATED CloakBrowser (anti-detect Chromium) for
# the agent. It uses its own user-data-dir and debugging port, so it never
# touches the user's everyday browser.

PORT="${FLOW_BROWSER_PORT:-9333}"
HOST="127.0.0.1"
PROFILE="${FLOW_BROWSER_PROFILE:-$HOME/.flow-browser/profile}"
TIMEOUT_STEPS="${FLOW_BROWSER_TIMEOUT_STEPS:-40}"
LOCK_DIR="${TMPDIR:-/tmp}/flow-browser-start-$PORT.lock"

log() { printf '%s\n' "$*" >&2; }
fail() { log "Flow Browser start failed: $*"; exit 1; }

need() {
  command -v "$1" >/dev/null 2>&1 || fail "missing command: $1"
}

cdp_ready() {
  command -v curl >/dev/null 2>&1 || return 1
  curl -fsS "http://$HOST:$PORT/json/version" >/dev/null 2>&1
}

# Acquire a start lock so two concurrent agents don't both spawn an instance
# (the old design's race that caused the quit/restart loop).
acquire_lock() {
  for _ in $(seq 1 60); do
    if mkdir "$LOCK_DIR" 2>/dev/null; then
      trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT
      return 0
    fi
    cdp_ready && return 1   # someone else already brought it up
    sleep 0.5
  done
  return 1
}

find_cloak_bin() {
  local bin="${FLOW_BROWSER_BIN:-}"
  if [ -n "$bin" ]; then
    [ -x "$bin" ] && printf '%s\n' "$bin" && return 0
    fail "FLOW_BROWSER_BIN is not executable: $bin"
  fi
  local p
  p="$(ls -d "$HOME/.cloakbrowser"/chromium-*/Chromium.app/Contents/MacOS/Chromium 2>/dev/null | sort -V | tail -n 1 || true)"
  [ -n "$p" ] && [ -x "$p" ] && printf '%s\n' "$p" && return 0
  return 1
}

need agent-browser
need curl

# A long-lived agent-browser daemon may already be bound to a different port.
# `--cdp <port>` does not re-point a running daemon, so reconnect explicitly.
reconnect_daemon() {
  agent-browser connect "$PORT" >/dev/null 2>&1 || true
}

# Already up? Just reuse it (re-point the daemon in case it held an old port).
if cdp_ready; then
  reconnect_daemon
  log "Flow Browser CDP ready on $PORT (dedicated instance)"
  exit 0
fi

if ! acquire_lock; then
  if cdp_ready; then
    reconnect_daemon
    log "Flow Browser CDP ready on $PORT (started by a concurrent run)"
    exit 0
  fi
  fail "could not acquire start lock and CDP not ready on $PORT"
fi

CLOAK_BIN="$(find_cloak_bin || true)"
[ -n "$CLOAK_BIN" ] || fail "CloakBrowser binary not found. Run: cloakbrowser install (or set FLOW_BROWSER_BIN)"

mkdir -p "$PROFILE"

set -- \
  --user-data-dir="$PROFILE" \
  --remote-debugging-port="$PORT" \
  --no-first-run \
  --no-default-browser-check
# Headless by default (Chromium 132+ unified headless: same browser code,
# extensions/login/screenshots all work, never steals the user's viewport).
# FLOW_BROWSER_HEADED=1 opts into a visible window (watch flows, captcha, anti-bot).
MODE=headless
if [ "${FLOW_BROWSER_HEADED:-0}" = "1" ]; then
  MODE=headed
else
  # --mute-audio：无头实例用户看不见也关不掉，禁止它出声（AutoMusic 等 autoplay 场景）
  set -- "$@" --headless --window-size=1440,900 --mute-audio
fi
set -- "$@" about:blank

log "Starting a dedicated $MODE CloakBrowser instance on port $PORT (profile: $PROFILE)"
# Spawn the binary directly (not `open`) so it runs as our own detached child:
# a single window, its own profile, its own port. The user's browser is untouched.
# Passing a startup URL guarantees one visible window opens.
"$CLOAK_BIN" "$@" \
  >/dev/null 2>&1 &
disown || true

for _ in $(seq 1 "$TIMEOUT_STEPS"); do
  if cdp_ready; then
    reconnect_daemon
    agent-browser --cdp "$PORT" get url >/dev/null 2>&1 || true
    log "Flow Browser CDP ready on $PORT (dedicated instance)"
    exit 0
  fi
  sleep 0.5
done

fail "could not connect to dedicated CloakBrowser CDP on $PORT"
