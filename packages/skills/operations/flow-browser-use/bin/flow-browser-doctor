#!/usr/bin/env bash
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT="${FLOW_BROWSER_PORT:-9333}"
HOST="127.0.0.1"
PROFILE="${FLOW_BROWSER_PROFILE:-$HOME/.flow-browser/profile}"
START=0
FAILURES=0

usage() {
  cat <<'EOF'
Usage: flow-browser doctor [--start]

Checks the local Flow Browser environment without printing private browser data.

Options:
  --start     Start the dedicated CloakBrowser instance before checking CDP.
  -h, --help  Show this help.

Invalid arguments print this usage and exit 2.
EOF
}

case "$#" in
  0) ;;
  1)
    case "$1" in
      --start) START=1 ;;
      -h|--help) usage; exit 0 ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  *) usage >&2; exit 2 ;;
esac

ok() { printf 'OK   %s\n' "$*"; }
warn() { printf 'WARN %s\n' "$*"; }
mark_fail() { printf 'FAIL %s\n' "$*"; FAILURES=$((FAILURES + 1)); }

find_cloak_bin() {
  local bin="${FLOW_BROWSER_BIN:-}" p
  if [ -n "$bin" ]; then
    [ -x "$bin" ] && printf '%s\n' "$bin" && return 0
    return 1
  fi
  p="$(ls -d "$HOME/.cloakbrowser"/chromium-*/Chromium.app/Contents/MacOS/Chromium 2>/dev/null | sort -V | tail -n 1 || true)"
  [ -n "$p" ] && [ -x "$p" ] && printf '%s\n' "$p" && return 0
  return 1
}

check_commands() {
  local agent_browser_path
  agent_browser_path="$(command -v agent-browser 2>/dev/null || true)"
  if [ -n "$agent_browser_path" ]; then
    ok "agent-browser found: $agent_browser_path"
  else
    mark_fail "agent-browser not found in PATH"
  fi

  if command -v curl >/dev/null 2>&1; then
    ok "curl found"
  else
    mark_fail "curl not found; CDP checks unavailable"
  fi
}

check_cloak() {
  local cloak_bin
  cloak_bin="$(find_cloak_bin || true)"
  if [ -n "$cloak_bin" ]; then
    ok "CloakBrowser binary found: $cloak_bin"
  elif [ -n "${FLOW_BROWSER_BIN:-}" ]; then
    mark_fail "FLOW_BROWSER_BIN is not executable: $FLOW_BROWSER_BIN"
  else
    mark_fail "CloakBrowser binary not found. Run: cloakbrowser install"
  fi

  # Encryption key exists once CloakBrowser has run; sync-profile needs it.
  if security find-generic-password -s "Chromium Safe Storage" -a Chromium >/dev/null 2>&1; then
    ok "Keychain: Chromium Safe Storage present (profile sync possible)"
  else
    warn "Keychain: Chromium Safe Storage missing; run flow-browser-start once before sync-profile"
  fi
}

check_profile() {
  local size_mb
  if [ ! -d "$PROFILE" ]; then
    warn "profile path missing: $PROFILE (created by flow-browser-start)"
    return
  fi

  size_mb="$(du -sm "$PROFILE" 2>/dev/null | awk '{print $1}' || true)"
  if [ -z "$size_mb" ]; then
    warn "profile path exists but size could not be read: $PROFILE"
    return
  fi

  ok "profile path exists: $PROFILE (${size_mb}M)"
  if [ "$size_mb" -gt 500 ]; then
    warn "profile is ${size_mb}M (>500M); consider refreshing it when safe"
  fi
}

check_cdp() {
  local version_json tabs_json browser tab_count
  if ! command -v curl >/dev/null 2>&1; then
    return
  fi

  if ! version_json="$(curl -fsS "http://$HOST:$PORT/json/version" 2>/dev/null)"; then
    if [ "$START" = "1" ]; then
      mark_fail "CDP /json/version not reachable on $HOST:$PORT after --start"
    else
      warn "CDP /json/version not reachable on $HOST:$PORT (browser not running; use doctor --start to verify launch)"
    fi
    return
  fi

  if ! tabs_json="$(curl -fsS "http://$HOST:$PORT/json/list" 2>/dev/null)"; then
    mark_fail "CDP /json/list not reachable on $HOST:$PORT"
    return
  fi

  if ! command -v jq >/dev/null 2>&1; then
    ok "CDP /json/version reachable on $HOST:$PORT"
    ok "CDP /json/list reachable on $HOST:$PORT"
    warn "jq not found; skipping CDP JSON details and tab summary"
    return
  fi

  browser="$(printf '%s' "$version_json" | jq -r '.Browser // .browser // "unknown"' 2>/dev/null)" || {
    mark_fail "CDP /json/version returned invalid JSON"
    return
  }
  ok "CDP /json/version reachable on $HOST:$PORT ($browser)"

  tab_count="$(printf '%s' "$tabs_json" | jq -r 'if type == "array" then length else empty end' 2>/dev/null)" || {
    mark_fail "CDP /json/list returned invalid JSON"
    return
  }
  if [ -z "$tab_count" ]; then
    mark_fail "CDP /json/list did not return a JSON array"
    return
  fi

  ok "CDP /json/list tabs: $tab_count"
  if [ "$tab_count" -gt 0 ]; then
    printf '%s' "$tabs_json" | jq -r '
      def clean_title:
        (. // "(untitled)")
        | gsub("[\\r\\n\\t]+"; " ")
        | if length > 60 then .[0:60] + "…" else . end;
      def clean_url:
        (. // "")
        | sub("[?#].*$"; "");
      .[0:5]
      | to_entries[]
      | "OK   tab [" + ((.key + 1) | tostring) + "] " + (.value.title | clean_title) + " — " + (.value.url | clean_url)
    '
  fi
  if [ "$tab_count" -gt 5 ]; then
    warn "tab summary truncated to first 5 of $tab_count"
  fi
}

# flow-browser-console 依赖 CloakBrowser 反检测补丁漏堵的 legacy Console domain；
# 上游随时可能补掉，这里用临时 data: tab 实际验证一次读回链路。
check_console_fallback() {
  local marker tab_json tab_id out
  curl -fsS "http://$HOST:$PORT/json/version" >/dev/null 2>&1 || return  # 实例没跑，check_cdp 已报告
  command -v node >/dev/null 2>&1 || { warn "node not found; skipping console fallback check"; return; }
  marker="FLOW_DOCTOR_CONSOLE_$$"
  tab_json="$(curl -fsS -X PUT "http://$HOST:$PORT/json/new?data:text/html,<script>console.log('$marker')</script>" 2>/dev/null)" || {
    warn "could not open probe tab; skipping console fallback check"
    return
  }
  tab_id="$(printf '%s' "$tab_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' 2>/dev/null)"
  sleep 0.5
  out="$("$DIR/flow-browser-console" "$marker" --wait 1 2>/dev/null || true)"
  [ -n "$tab_id" ] && curl -fsS "http://$HOST:$PORT/json/close/$tab_id" >/dev/null 2>&1
  if printf '%s' "$out" | grep -q "$marker"; then
    ok "console fallback (legacy Console domain) readable"
  else
    mark_fail "console fallback broken — CloakBrowser may have patched legacy Console domain; flow-browser-console is blind"
  fi
}

if [ "$START" = "1" ]; then
  if "$DIR/flow-browser-start" >/dev/null 2>&1; then
    ok "flow-browser-start completed"
  else
    warn "flow-browser-start exited non-zero; continuing diagnostics"
  fi
fi

check_commands
check_cloak
check_profile
check_cdp
check_console_fallback

if [ "$FAILURES" -gt 0 ]; then
  exit 1
fi
exit 0
