{
	// 公开推荐配置：除 Bark 外功能全开。复制后重启 Pi。
	// Watcher 默认在每个主会话回合后调用模型；OpenAI priority 会按供应商规则加价。
	"features": {
		"header": true,
		"statusbar": true,
		"tools": true,
		"presets": true,
		"rename": true,
		"stats": true,
		"claudeSub": true,
		"openaiNative": true,
		"workingFlame": true,
		"bark": false,
		"review": true,
		"master": true,
		"watcher": true
	},

	"keys": {
		"rename": "ctrl+r",
		"cyclePreset": "ctrl+shift+u",
		"fast": "ctrl+f"
	},

	// nativeCompaction 使用 OpenAI 原生上下文压缩；priority 加钱换更快出字。
	"openai": {
		"nativeCompaction": true,
		"providers": {
			"openai-codex": { "textVerbosity": "low", "priority": true },
			"xai": { "priority": true }
		}
	},

	// 每个主会话回合后评估新增内容，会产生额外模型调用；需要开口时当场插话。
	"watcher": {
		"enabled": true,
		"model": "openai-codex/gpt-5.6-sol",
		"thinking": "low",
		"context": "minimal"
	},

	// 新会话默认激活指挥官；模型必须是 provider/model。
	"master": {
		"autoActivate": true,
		"workerExcludeExtensions": [],
		"models": [
			{
				"model": "openai-codex/gpt-5.6-sol",
				"thinking": "medium",
				"use": "默认使用，常规实现/调试（速度快，偏 Debug 或纯执行，但容易过度工程过度测试）"
			},
			{
				"model": "openai-codex/gpt-5.6-luna",
				"thinking": "xhigh",
				"use": "大规模并行，便宜，适合调研任务，不适合实现"
			},
			{
				"model": "anthropic/claude-opus-5",
				"thinking": "medium",
				"use": "常规实现/调试（速度中等，偏前端或综合）"
			},
			{
				"model": "anthropic/claude-fable-5",
				"thinking": "high",
				"use": "高级架构问题顾问，可原地执行，贵，用之前要和用户确认"
			},
			{
				"model": "kimi-coding/k3-256k",
				"thinking": "high",
				"use": "速度慢，纯视觉设计师，已有固定组件和设计方案时不适用"
			}
		]
	},

	"presets": {
		"fable": { "provider": "anthropic", "model": "claude-fable-5", "thinkingLevel": "high", "key": "alt+1" },
		"opus5": { "provider": "anthropic", "model": "claude-opus-5", "thinkingLevel": "medium", "key": "alt+2" },
		"sol": { "provider": "openai-codex", "model": "gpt-5.6-sol", "thinkingLevel": "medium", "key": "alt+3" },
		"gemini": { "provider": "antigravity", "model": "gemini-3.7-flash", "thinkingLevel": "high", "key": "alt+4" },
		"ds": { "provider": "deepseek", "model": "deepseek-v4-flash", "thinkingLevel": "high", "key": "alt+5" },
		"k3-256": { "provider": "kimi-coding", "model": "k3-256k", "thinkingLevel": "high", "key": "alt+6" },
		"xai": { "provider": "xai", "model": "grok-4.6", "thinkingLevel": "high", "key": "alt+7" }
	},

	// 审查只在用户或指挥官发起时调用模型。
	"review": {
		"advisor": { "model": "anthropic/claude-fable-5", "thinking": "high" },
		"reviewers": [
			{ "model": "anthropic/claude-sonnet-5", "thinking": "medium" },
			{ "model": "anthropic/claude-opus-5", "thinking": "medium" }
		],
		"maxRounds": 5,
		"advisorAfterFailures": 2,
		"timeoutMinutes": 20,
		"tools": ["read", "grep", "find", "ls", "bash"],
		"language": "zh"
	}
}
