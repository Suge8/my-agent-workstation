{
	// 公开推荐配置：除 Bark 外功能全开。复制后重启 Pi。
	// Watcher 默认在每个主会话回合后调用模型；OpenAI priority 会按供应商规则加价。
	// 凡是指定模型的位置都写同一个模型原子："provider/model/thinking"，思考档取最后一段。
	"features": {
		"header": true,
		"statusbar": true,
		"tools": true,
		"presets": true,
		"rename": true,
		"stats": true,
		"claudeSub": true,
		"openaiNative": true,
		"workingFlame": true,
		"bark": false,
		"review": true,
		"master": true,
		"watcher": true
	},

	"keys": {
		"rename": "ctrl+r",
		"cyclePreset": "ctrl+shift+u",
		"fast": "ctrl+f"
	},

	// nativeCompaction 使用 OpenAI 原生上下文压缩；priority 加钱换更快出字。
	"openai": {
		"nativeCompaction": true,
		"providers": {
			"openai-codex": { "textVerbosity": "low", "priority": true },
			"xai": { "priority": true }
		}
	},

	// 每个主会话回合后评估新增内容，会产生额外模型调用；需要开口时当场插话。
	"watcher": {
		"enabled": true,
		"model": "openai-codex/gpt-5.6-sol/low",
		"context": "minimal"
	},

	// 新会话默认激活指挥官。
	"master": {
		"autoActivate": true,
		"workerExcludeExtensions": [],
		"roles": {
			"调研员": {
				"model": "openai-codex/gpt-5.6-luna/xhigh",
				"use": "大规模并行调研，便宜，不做实现"
			},
			"工程师": {
				"model": "openai-codex/gpt-5.6-sol/medium",
				"use": "默认实现/调试（速度快，偏 Debug 或纯执行，但容易过度工程过度测试）",
				"fallback": ["anthropic/claude-opus-5/medium"]
			},
			"全栈": {
				"model": "anthropic/claude-opus-5/medium",
				"use": "前端/审美/综合实现（速度中等）",
				"fallback": ["openai-codex/gpt-5.6-sol/medium"]
			},
			"架构师": {
				"model": "anthropic/claude-fable-5/high",
				"use": "高级架构咨询与关键实现，可原地执行，贵，启用前需先征求用户确认"
			},
			"设计师": {
				"model": "kimi-coding/k3-256k/high",
				"use": "纯视觉创造，速度慢，已有固定组件和设计方案时不适用"
			},
			"哨兵": {
				"model": "openai-codex/gpt-5.6-luna/low",
				"use": "CI/部署/长测试等待盯守"
			}
		}
	},

	"presets": {
		"fable": { "model": "anthropic/claude-fable-5/high", "key": "alt+1" },
		"opus5": { "model": "anthropic/claude-opus-5/medium", "key": "alt+2" },
		"sol": { "model": "openai-codex/gpt-5.6-sol/medium", "key": "alt+3" },
		"gemini": { "model": "antigravity/gemini-3.7-flash/high", "key": "alt+4" },
		"ds": { "model": "deepseek/deepseek-v4-flash/high", "key": "alt+5" },
		"k3-256": { "model": "kimi-coding/k3-256k/high", "key": "alt+6" },
		"xai": { "model": "xai/grok-4.6/high", "key": "alt+7" }
	},

	// 审查只在用户或指挥官发起时调用模型。
	"review": {
		"advisor": "anthropic/claude-fable-5/high",
		"reviewers": ["anthropic/claude-sonnet-5/medium", "anthropic/claude-opus-5/medium"],
		"maxRounds": 5,
		"advisorAfterFailures": 2,
		"timeoutMinutes": 20,
		"tools": ["read", "grep", "find", "ls", "bash"],
		"language": "zh"
	}
}
