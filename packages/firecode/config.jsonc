{
  "features": {
    "header": true,
    "statusbar": true,
    "tools": true,
    "presets": false,
    "rename": true,
    "stats": true,
    "claudeSub": false,
    "openaiNative": false,
    "workingFlame": true,
    "bark": false,
    "review": false,
    "master": false
  },
  "keys": {
    "rename": "ctrl+r",
    "cyclePreset": "ctrl+shift+u",
    "fast": "ctrl+f"
  },
  "openai": {
    "nativeCompaction": true,
    "providers": {
      "openai-codex": { "textVerbosity": "low", "priority": true },
      "xai": { "priority": true }
    }
  },
  "master": {
    "models": [
      { "model": "openai/gpt-4.1", "thinking": "medium", "use": "通用实现与调试" }
    ]
  },
  "presets": {
    "default": {
      "provider": "openai",
      "model": "gpt-4.1",
      "thinkingLevel": "medium",
      "key": "alt+1"
    }
  },
  "review": {
    "advisor": { "model": "openai/gpt-4.1", "thinking": "high" },
    "reviewers": [
      { "model": "openai/gpt-4.1", "thinking": "high" }
    ],
    "maxRounds": 5,
    "advisorAfterFailures": 2,
    "timeoutMinutes": 20,
    "tools": ["read", "grep", "find", "ls", "bash"],
    "background": { "command": "pi" },
    "language": "zh"
  }
}
