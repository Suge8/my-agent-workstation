#!/bin/bash

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
PACKAGE='@earendil-works/pi-coding-agent'
PACKAGE_LATEST_URL='https://registry.npmjs.org/@earendil-works%2Fpi-coding-agent/latest'
PI_FORMULA='pi-coding-agent'
STATE_HOME="${MYAW_HOME:-${XDG_DATA_HOME:-${HOME:?}/.local/share}/my-agent-workstation}"
JSON=0
YES=0
MODE=core
REPLACE_SYSTEM=0
KEEP_SYSTEM=0
SYSTEM_CHOICE_EXPLICIT=0
WITH_BCU=0
WITH_BROWSER=0
WITH_TERMINAL=0
WITH_HELIUM=0
WITH_SEARCH=0
MIGRATE_HERDR=0
SELECTIONS=
FORCE_UPDATE=0
. "$ROOT/lib/workstation.sh"

usage() {
  printf '%s\n' '用法: setup [doctor|plan|apply|verify|update|repair|uninstall|configure-search] [选项]'
  printf '%s\n' '选项: --mode full|core|custom  --yes  --json  --replace-system|--keep-system'
  printf '%s\n' '      --with-bcu --with-browser --with-terminal --with-helium --with-search'
  printf '%s\n' '      --selections <json>  --migrate-herdr  --dry-run'
}

parse_options() {
  shift
  while test "$#" -gt 0; do
    case "$1" in
      --json) JSON=1 ;;
      --yes) YES=1 ;;
      --mode) shift; MODE=${1:-} ;;
      --replace-system) REPLACE_SYSTEM=1; SYSTEM_CHOICE_EXPLICIT=1 ;;
      --keep-system) KEEP_SYSTEM=1; SYSTEM_CHOICE_EXPLICIT=1 ;;
      --with-bcu) WITH_BCU=1 ;;
      --with-browser) WITH_BROWSER=1 ;;
      --with-terminal) WITH_TERMINAL=1 ;;
      --with-helium) WITH_HELIUM=1 ;;
      --with-search) WITH_SEARCH=1 ;;
      --migrate-herdr) MIGRATE_HERDR=1 ;;
      --selections) shift; SELECTIONS=${1:-} ;;
      --dry-run) MYAW_DRY_RUN=1; export MYAW_DRY_RUN ;;
      *) printf '未知参数: %s\n' "$1" >&2; exit 64 ;;
    esac
    shift
  done
  test "$REPLACE_SYSTEM" -eq 0 || test "$KEEP_SYSTEM" -eq 0 || { printf '%s\n' '--replace-system 与 --keep-system 不能同时使用' >&2; exit 64; }
  if test -n "$SELECTIONS" && test ! -f "$SELECTIONS"; then printf '模型选择文件不存在: %s\n' "$SELECTIONS" >&2; exit 64; fi
}

json_string() {
  printf '%s' "$1" | awk 'BEGIN { ORS="" } { gsub(/\\/, "\\\\"); gsub(/\"/, "\\\""); if (NR > 1) printf "\\n"; printf "%s", $0 }'
}

reject() {
  if test "$JSON" -eq 1; then
    printf '{"supported":false,"reason":"'
    json_string "$1"
    printf '"}\n'
  else
    printf '不支持：%s\n' "$1"
  fi
  exit 2
}

check_platform() {
  OS=$(uname -s 2>/dev/null || printf unknown)
  ARCH=$(uname -m 2>/dev/null || printf unknown)
  MACOS=$(sw_vers -productVersion 2>/dev/null || printf 0)
  MACOS_MAJOR=${MACOS%%.*}
  test "$OS" = Darwin || reject '仅支持 macOS'
  test "$ARCH" = arm64 || reject '仅支持 Apple Silicon (arm64)'
  case "$MACOS_MAJOR" in
    ''|*[!0-9]*) reject '无法识别 macOS 版本' ;;
  esac
  test "$MACOS_MAJOR" -ge 14 || reject '仅支持 macOS 14 及以上'
  test "${SHELL##*/}" = zsh || reject '登录 Shell 必须是 Zsh'
}

command_works() {
  command -v "$1" >/dev/null 2>&1 && "$1" "$2" >/dev/null 2>&1
}

latest_pi_version() {
  curl -fsSL "$PACKAGE_LATEST_URL" 2>/dev/null |
    awk 'match($0, /"version"[[:space:]]*:[[:space:]]*"[^"]+"/) { value=substr($0, RSTART, RLENGTH); sub(/^.*"version"[[:space:]]*:[[:space:]]*"/, "", value); sub(/"$/, "", value); print value; exit }'
}

latest_herdr_version() {
  curl -fsSL https://herdr.dev/latest.json 2>/dev/null |
    awk 'match($0, /"version"[[:space:]]*:[[:space:]]*"[^"]+"/) { value=substr($0, RSTART, RLENGTH); sub(/^.*"version"[[:space:]]*:[[:space:]]*"/, "", value); sub(/"$/, "", value); print value; exit }'
}

version_is_newer() {
  awk -v candidate="$1" -v installed="$2" 'BEGIN {
    sub(/^v/, "", candidate); sub(/^v/, "", installed)
    split(candidate, a, /[.-]/); split(installed, b, /[.-]/)
    for (i = 1; i <= 3; i++) {
      if ((a[i] + 0) > (b[i] + 0)) exit 0
      if ((a[i] + 0) < (b[i] + 0)) exit 1
    }
    exit 1
  }'
}

detect() {
  HOMEBREW_NO_AUTO_UPDATE=1
  HOMEBREW_NO_ANALYTICS=1
  export HOMEBREW_NO_AUTO_UPDATE HOMEBREW_NO_ANALYTICS
  HOMEBREW_STATUS=missing
  command_works brew --version && HOMEBREW_STATUS=normal

  node_ok=0
  npm_ok=0
  command_works node --version && node_ok=1
  command_works npm --version && npm_ok=1
  NODE_STATUS=missing
  NODE_SOURCE=none
  NODE_VERSION=''
  if test "$node_ok" -eq 1 && test "$npm_ok" -eq 1; then
    NODE_STATUS=normal
    NODE_VERSION=$(node --version 2>/dev/null)
    if brew list --versions node >/dev/null 2>&1; then NODE_SOURCE=homebrew; else NODE_SOURCE=system; fi
  elif test "$node_ok" -ne "$npm_ok"; then
    NODE_STATUS=conflict
    NODE_SOURCE=partial
  fi

  PI_STATUS=missing
  PI_SOURCE=none
  PI_VERSION=''
  npm_line=$(npm_config_logs_max=0 npm_config_update_notifier=false npm list -g --depth=0 "$PACKAGE" 2>/dev/null || true)
  case "$npm_line" in
    *"$PACKAGE"@*)
      PI_SOURCE=npm
      PI_VERSION=${npm_line##*@}
      PI_VERSION=${PI_VERSION%%[[:space:]]*}
      PI_STATUS=normal
      if ! pi --version >/dev/null 2>&1; then
        PI_STATUS=conflict
      elif brew list --versions "$PI_FORMULA" >/dev/null 2>&1; then
        PI_SOURCE=npm+homebrew
        PI_STATUS=conflict
      else
        latest=$(latest_pi_version || true)
        if test -z "$latest"; then
          PI_STATUS=unknown
        elif version_is_newer "$latest" "$PI_VERSION"; then
          PI_STATUS=update_available
        fi
      fi
      ;;
    *)
      if pi --version >/dev/null 2>&1; then
        PI_VERSION=$(pi --version 2>/dev/null | awk 'NR == 1 { print $NF }')
        if brew list --versions "$PI_FORMULA" >/dev/null 2>&1; then
          PI_SOURCE=homebrew
        else
          PI_SOURCE=source
        fi
        PI_STATUS=conflict
      fi
      ;;
  esac

  HERDR_STATUS=missing
  HERDR_SOURCE=none
  HERDR_VERSION=''
  if herdr --version >/dev/null 2>&1; then
    HERDR_VERSION=$(herdr --version 2>/dev/null | awk 'NR == 1 { print $NF }')
    herdr_path=$(command -v herdr)
    official_herdr=${MYAW_HERDR_PATH:-$HOME/.local/bin/herdr}
    if test "$herdr_path" = "$official_herdr"; then
      HERDR_SOURCE=official
      HERDR_STATUS=normal
    else
      if brew list --versions herdr >/dev/null 2>&1; then HERDR_SOURCE=homebrew; else HERDR_SOURCE=other; fi
      HERDR_STATUS=conflict
    fi
    if test "$HERDR_SOURCE" = official; then
      latest_herdr=$(latest_herdr_version || true)
      if test -z "$latest_herdr"; then HERDR_STATUS=unknown
      elif version_is_newer "$latest_herdr" "$HERDR_VERSION"; then HERDR_STATUS=update_available
      fi
    fi
  elif brew list --versions herdr >/dev/null 2>&1; then
    HERDR_SOURCE=homebrew
    HERDR_STATUS=conflict
  fi

  SERVICE_STATUS=missing
  launchctl print "gui/$(id -u)/dev.myagentworkstation.herdr" >/dev/null 2>&1 && SERVICE_STATUS=normal
  INTEGRATION_STATUS=missing
  herdr integration status 2>/dev/null | awk 'tolower($1) == "pi:" && tolower($2) == "current" { found=1 } END { exit !found }' && INTEGRATION_STATUS=normal

  MODEL_AUTH_STATUS=missing
  ready_providers=$(authenticated_providers)
  test -z "$ready_providers" || MODEL_AUTH_STATUS=normal

  BCU_PERMISSION_STATUS=missing
  if command -v bcu >/dev/null 2>&1 && bcu --help >/dev/null 2>&1; then
    BCU_PERMISSION_STATUS=unknown
    bcu_status=$(bcu status --json 2>/dev/null || true)
    if printf '%s' "$bcu_status" | node -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>{try{const j=JSON.parse(s),r=j.result??j;process.exit(r.running===true?0:1)}catch{process.exit(1)}})' 2>/dev/null; then
      bcu_doctor=$(bcu doctor --json 2>/dev/null || true)
      if printf '%s' "$bcu_doctor" | node -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>{try{const j=JSON.parse(s),r=j.result??j,p=r.permissions,h=r.helper,b=r.broker;process.exit(p?.accessibility===true&&p?.screenRecording===true&&Number.isInteger(h?.protocolVersion)&&Number.isInteger(b?.pid)?0:1)}catch{process.exit(1)}})' 2>/dev/null; then
        BCU_PERMISSION_STATUS=normal
      else
        BCU_PERMISSION_STATUS=conflict
      fi
    fi
  fi

  agent_browser=missing
  cloak_browser=missing
  agent-browser --version >/dev/null 2>&1 && agent_browser=normal
  cloakbrowser info >/dev/null 2>&1 && cloak_browser=normal
  if test "$agent_browser" = normal && test "$cloak_browser" = normal; then
    if test "$WITH_BROWSER" -eq 1 && { ! check_integrity browser || ! check_integrity shell-init || ! managed_block_is "$HOME/.zshrc" "$(shell_hook_body)"; }; then
      BROWSER_STATUS=conflict
    else
      BROWSER_STATUS=normal
    fi
  elif test "$agent_browser" = missing && test "$cloak_browser" = missing; then
    BROWSER_STATUS=missing
  else
    BROWSER_STATUS=conflict
  fi
  workstation_detect
}

component_json() {
  status=$1 source=$2 version=$3
  printf '{"status":"%s","source":"%s"' "$status" "$source"
  test -n "$version" && printf ',"version":"%s"' "$version"
  printf '}'
}

print_doctor_json() {
  printf '{"supported":true,"system":{"arch":"%s","macos":"%s","shell":"zsh"},"components":{' "$ARCH" "$MACOS"
  printf '"homebrew":{"status":"%s","source":"%s"},' "$HOMEBREW_STATUS" "$(test "$HOMEBREW_STATUS" = normal && printf homebrew || printf none)"
  printf '"node":'; component_json "$NODE_STATUS" "$NODE_SOURCE" "$NODE_VERSION"; printf ','
  printf '"pi":'; component_json "$PI_STATUS" "$PI_SOURCE" "$PI_VERSION"; printf ','
  printf '"herdr":'; component_json "$HERDR_STATUS" "$HERDR_SOURCE" "$HERDR_VERSION"; printf ','
  printf '"herdr_service":{"status":"%s","source":"launchd"},' "$SERVICE_STATUS"
  printf '"pi_integration":{"status":"%s","source":"herdr"}' "$INTEGRATION_STATUS"
  printf '},"capabilities":{'
  printf '"model_auth":{"status":"%s","source":"pi"},' "$MODEL_AUTH_STATUS"
  printf '"bcu_permissions":{"status":"%s","source":"bcu"},' "$BCU_PERMISSION_STATUS"
  printf '"browser":{"status":"%s","source":"agent-browser+cloakbrowser"}' "$BROWSER_STATUS"
  printf '}'
  workstation_print_doctor_json
  printf '}\n'
}

print_doctor() {
  if test "$JSON" -eq 1; then
    print_doctor_json
  else
    printf '系统: 支持 (%s, macOS %s, Zsh)\n' "$ARCH" "$MACOS"
    printf 'Homebrew: %s\nNode/npm: %s (%s)\nPi: %s (%s)\nHerdr: %s (%s)\nHerdr 服务: %s\nPi integration: %s\n模型认证: %s\nBCU 权限: %s\n浏览器能力: %s\n工作站 Package: %s\nSYSTEM: %s\n终端配置: %s\nHelium: %s\n搜索凭据: %s\n' \
      "$HOMEBREW_STATUS" "$NODE_STATUS" "$NODE_SOURCE" "$PI_STATUS" "$PI_SOURCE" "$HERDR_STATUS" "$HERDR_SOURCE" "$SERVICE_STATUS" "$INTEGRATION_STATUS" "$MODEL_AUTH_STATUS" "$BCU_PERMISSION_STATUS" "$BROWSER_STATUS" "$PACKAGE_STATUS" "$SYSTEM_STATUS" "$TERMINAL_STATUS" "$HELIUM_STATUS" "$SEARCH_STATUS"
  fi
}

build_plan() {
  ACTIONS=()
  test "$HOMEBREW_STATUS" = missing && ACTIONS+=(install_homebrew)
  test "$NODE_STATUS" = missing && ACTIONS+=(install_node)
  case "$PI_STATUS:$PI_SOURCE" in
    missing:*|update_available:npm) ACTIONS+=(install_pi) ;;
    conflict:homebrew|conflict:npm+homebrew) ACTIONS+=(migrate_pi_from_homebrew install_pi) ;;
    normal:npm|unknown:npm) test "$FORCE_UPDATE" -eq 0 || ACTIONS+=(install_pi) ;;
  esac
  case "$HERDR_STATUS:$HERDR_SOURCE" in
    missing:*) ACTIONS+=(install_herdr) ;;
    update_available:official) ACTIONS+=(update_herdr) ;;
    normal:official|unknown:official) ;;
    conflict:homebrew) test "$MIGRATE_HERDR" -eq 0 || ACTIONS+=(migrate_herdr_from_homebrew install_herdr start_herdr_service) ;;
  esac
  test "$HERDR_STATUS" != conflict && test "$SERVICE_STATUS" = missing && ACTIONS+=(start_herdr_service)
  test "$HERDR_STATUS" != conflict && test "$INTEGRATION_STATUS" = missing && ACTIONS+=(install_pi_integration)
  workstation_append_plan
}

print_actions_json() {
  printf '['
  separator=''
  for action in "${ACTIONS[@]}"; do
    printf '%s"%s"' "$separator" "$action"
    separator=,
  done
  printf ']'
}

print_plan() {
  if test "$JSON" -eq 1; then
    printf '{"supported":true,"actions":'; print_actions_json; printf '}\n'
    return
  fi
  if test "${#ACTIONS[@]}" -eq 0; then
    printf '无需变更。\n'
    return
  fi
  printf '计划执行：\n'
  for action in "${ACTIONS[@]}"; do printf '  - %s\n' "$action"; done
}

install_homebrew() {
  test "$JSON" -eq 1 || printf 'Homebrew 用于安装和管理 Node、Herdr 及其登录服务。\n'
  installer=$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh) || return 1
  NONINTERACTIVE=1 /bin/bash -c "$installer" || return 1
  if ! brew --version >/dev/null 2>&1; then
    PATH="/opt/homebrew/bin:$PATH"
    export PATH
  fi
  brew --version >/dev/null 2>&1
}

install_herdr_official() {
  installer=$(mktemp "${TMPDIR:-/tmp}/herdr-install.XXXXXX") || return 1
  curl -fsSL https://herdr.dev/install.sh -o "$installer" || { rm -f "$installer"; return 1; }
  /bin/sh "$installer" || { rm -f "$installer"; return 1; }
  rm -f "$installer"
  PATH="$HOME/.local/bin:$PATH"
  export PATH
  herdr channel set stable >/dev/null
  mkdir -p "$STATE_HOME/config/shell.d"
  : > "$STATE_HOME/herdr-official"
  # shellcheck disable=SC2016 # Write the expansion into the generated Zsh file.
  printf 'export PATH=%q:$PATH\n' "$HOME/.local/bin" > "$STATE_HOME/config/shell.d/path.zsh"
  rebuild_shell_init || return
  ensure_shell_hook
  herdr --version >/dev/null
}

start_herdr_login_service() {
  binary=$(command -v herdr) || return 1
  label=dev.myagentworkstation.herdr
  plist="$HOME/Library/LaunchAgents/$label.plist"
  mkdir -p "$(dirname "$plist")" "$STATE_HOME/logs"
  backup_once "$plist" herdr.plist
  own_component herdr-service
  BINARY="$binary" HOME_VALUE="$HOME" STATE_VALUE="$STATE_HOME" PLIST="$plist" node - <<'NODE'
const fs = require("node:fs");
const escape = (value) => value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
const xml = `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>dev.myagentworkstation.herdr</string>
<key>ProgramArguments</key><array><string>${escape(process.env.BINARY)}</string><string>server</string></array>
<key>RunAtLoad</key><true/>
<key>EnvironmentVariables</key><dict><key>HOME</key><string>${escape(process.env.HOME_VALUE)}</string></dict>
<key>StandardOutPath</key><string>${escape(`${process.env.STATE_VALUE}/logs/herdr.log`)}</string>
<key>StandardErrorPath</key><string>${escape(`${process.env.STATE_VALUE}/logs/herdr.log`)}</string>
</dict></plist>
`;
fs.writeFileSync(process.env.PLIST, xml, { mode: 0o600 });
NODE
  domain="gui/$(id -u)"
  launchctl bootout "$domain/$label" >/dev/null 2>&1 || true
  launchctl bootstrap "$domain" "$plist" >/dev/null
}

run_action() {
  case "$1" in
    install_homebrew) install_homebrew ;;
    install_node) brew install node >/dev/null ;;
    migrate_pi_from_homebrew) brew uninstall "$PI_FORMULA" >/dev/null ;;
    install_pi) npm install --global --ignore-scripts "$PACKAGE@latest" >/dev/null ;;
    migrate_herdr_from_homebrew) brew services stop herdr >/dev/null 2>&1 || true; brew uninstall herdr >/dev/null ;;
    install_herdr|update_herdr) install_herdr_official ;;
    start_herdr_service) start_herdr_login_service ;;
    install_pi_integration) herdr integration install pi >/dev/null && own_component integration ;;
    *) workstation_run_action "$1" ;;
  esac
}

is_valid() {
  test "$HOMEBREW_STATUS" = normal || return 1
  test "$NODE_STATUS" = normal || return 1
  case "$PI_STATUS" in normal|unknown) ;; *) return 1 ;; esac
  case "$HERDR_STATUS" in normal|unknown) ;; *) return 1 ;; esac
  test "$SERVICE_STATUS" = normal || return 1
  test "$INTEGRATION_STATUS" = normal || return 1
  test "$PACKAGE_STATUS" = normal || return 1
  if owns_component system; then test "$SYSTEM_STATUS" = normal || return 1; fi
  if test "$WITH_BCU" -eq 1; then test "$BCU_PERMISSION_STATUS" = normal || return 1; fi
  if test "$WITH_BROWSER" -eq 1; then test "$BROWSER_STATUS" = normal || return 1; fi
  if test "$WITH_TERMINAL" -eq 1; then test "$TERMINAL_STATUS" = normal || return 1; fi
  if test "$WITH_HELIUM" -eq 1; then test "$HELIUM_STATUS" = normal || return 1; fi
}

print_verify() {
  valid=false
  is_valid && valid=true
  if test "$JSON" -eq 1; then
    printf '{"valid":%s,"components":{' "$valid"
    printf '"homebrew":"%s","node":"%s","pi":"%s","herdr":"%s","herdr_service":"%s","pi_integration":"%s","workstation_package":"%s"' \
      "$HOMEBREW_STATUS" "$NODE_STATUS" "$PI_STATUS" "$HERDR_STATUS" "$SERVICE_STATUS" "$INTEGRATION_STATUS" "$PACKAGE_STATUS"
    printf '}}\n'
  elif test "$valid" = true; then
    printf '验证通过：核心运行时与所选工作站组件均可用。\n'
  else
    if test "$WITH_BCU" -eq 1 && test "$BCU_PERMISSION_STATUS" != normal; then
      printf '验证失败：BCU 需要 macOS 辅助功能和屏幕录制权限。请运行 bcu setup 后重试 setup verify。\n'
    else
      printf '验证失败，请运行 setup doctor 查看缺口。\n'
    fi
  fi
  test "$valid" = true
}

write_state() {
  mkdir -p "$STATE_HOME"
  STATE_FILE="$STATE_HOME/state.json" INSTALLATION_ROOT="$RUNTIME_HOME" MODE_VALUE="$MODE" VERSION_VALUE="$WORKSTATION_VERSION" \
  WITH_BCU_VALUE="$WITH_BCU" WITH_BROWSER_VALUE="$WITH_BROWSER" WITH_TERMINAL_VALUE="$WITH_TERMINAL" WITH_HELIUM_VALUE="$WITH_HELIUM" \
  node - <<'NODE'
const fs = require("node:fs");
const path = require("node:path");
const state = {
  schema: 1,
  status: "ready",
  version: process.env.VERSION_VALUE,
  mode: process.env.MODE_VALUE,
  installation_root: process.env.INSTALLATION_ROOT,
  selected: {
    bcu: process.env.WITH_BCU_VALUE === "1",
    browser: process.env.WITH_BROWSER_VALUE === "1",
    terminal: process.env.WITH_TERMINAL_VALUE === "1",
    helium: process.env.WITH_HELIUM_VALUE === "1",
  },
};
const temporary = `${process.env.STATE_FILE}.${process.pid}.tmp`;
fs.mkdirSync(path.dirname(process.env.STATE_FILE), { recursive: true });
fs.writeFileSync(temporary, `${JSON.stringify(state, null, 2)}\n`, { mode: 0o600 });
fs.renameSync(temporary, process.env.STATE_FILE);
NODE
}

load_state_options() {
  test -f "$STATE_HOME/state.json" || return 0
  value=$(STATE_FILE="$STATE_HOME/state.json" node -e '
    const s=JSON.parse(require("fs").readFileSync(process.env.STATE_FILE,"utf8"));
    const x=s.selected||{};
    process.stdout.write([s.mode||"core",x.bcu?1:0,x.browser?1:0,x.terminal?1:0,x.helium?1:0].join(" "));
  ' 2>/dev/null) || return 1
  IFS=' ' read -r MODE WITH_BCU WITH_BROWSER WITH_TERMINAL WITH_HELIUM <<EOF
$value
EOF
  MODE=${MODE:-core}; WITH_BCU=${WITH_BCU:-0}; WITH_BROWSER=${WITH_BROWSER:-0}; WITH_TERMINAL=${WITH_TERMINAL:-0}; WITH_HELIUM=${WITH_HELIUM:-0}
}

guard_apply() {
  if test "$JSON" -eq 1 && test "$YES" -ne 1; then printf '{"error":"结构化变更需要 --yes"}\n'; return 64; fi
  if test "$NODE_STATUS" = conflict; then printf '%s\n' 'Node/npm 工具链不完整；请修复后重试。' >&2; return 3; fi
  if test "$PI_STATUS" = conflict && test "$PI_SOURCE" != homebrew && test "$PI_SOURCE" != npm+homebrew; then
    if test "$PI_SOURCE" = source; then printf '%s\n' '检测到源码 Pi；为避免覆盖已拒绝应用。' >&2; else printf '%s\n' 'npm Pi 命令不可用；请检查 PATH。' >&2; fi
    return 3
  fi
  if test "$HERDR_STATUS" = conflict; then
    if test "$HERDR_SOURCE" = homebrew && test "$MIGRATE_HERDR" -eq 1; then :
    elif test "$HERDR_SOURCE" = homebrew; then printf '%s\n' 'Homebrew Herdr 版本通道可能滞后；迁移会停止现有 Pane，请确认后加 --migrate-herdr。' >&2; return 3
    else printf '%s\n' '检测到未知来源 Herdr；已拒绝覆盖。' >&2; return 3
    fi
  fi
  if test "$REPLACE_SYSTEM" -eq 0 && test "$KEEP_SYSTEM" -eq 0; then
    if test "$YES" -eq 1; then printf '%s\n' '必须显式选择 --replace-system 或 --keep-system。' >&2; return 64; fi
    if ask_yes '完整替换 Pi SYSTEM 提示词？原文件会备份。'; then REPLACE_SYSTEM=1; else KEEP_SYSTEM=1; fi
  fi
}

apply_plan() {
  guard_apply || return
  build_plan || return
  if test "${MYAW_DRY_RUN:-0}" = 1; then
    if test "$JSON" -eq 1; then printf '{"dry_run":true,"actions":'; print_actions_json; printf '}\n'; else print_plan; printf 'dry-run：未执行。\n'; fi
    return 0
  fi
  if test "$YES" -ne 1; then
    print_plan
    ask_yes '应用以上计划？' || { printf '已取消。\n'; return 1; }
  fi
  acquire_workstation_lock || return
  unset HOMEBREW_NO_AUTO_UPDATE
  for action in "${ACTIONS[@]}"; do
    run_action "$action" || { printf '动作失败: %s\n' "$action" >&2; return 1; }
  done
  if test "$WITH_SEARCH" -eq 1; then
    if test "$YES" -eq 1; then printf '搜索凭据未自动写入；请运行 setup configure-search。\n' >&2; else workstation_configure_search || return; fi
  fi
  detect
  if is_valid; then write_state; fi
  release_workstation_lock
  print_verify
}

main() {
  command=${1:-}
  if test -z "$command"; then workstation_wizard || exit; command=apply; else
    case "$command" in
      doctor|plan|apply|verify|update|repair|uninstall|configure-search) parse_options "$@" ;;
      -h|--help) usage; exit 0 ;;
      *) usage >&2; exit 64 ;;
    esac
  fi

  check_platform
  if test "$command" = update; then
    workstation_update_release
    release_result=$?
    case "$release_result" in 0) exit 0 ;; 1) ;; *) exit "$release_result" ;; esac
  fi
  case "$command" in
    update|repair|verify|uninstall) load_state_options || { printf '状态文件损坏。\n' >&2; exit 3; } ;;
  esac
  case "$command" in
    update) FORCE_UPDATE=1; prepare_update_system || exit ;;
    repair) test "$REPLACE_SYSTEM" -eq 1 || KEEP_SYSTEM=1 ;;
  esac
  workstation_mode_defaults || exit
  if test "$command" = configure-search; then
    acquire_workstation_lock || exit
    workstation_configure_search
    result=$?
    release_workstation_lock
    exit "$result"
  fi
  detect
  case "$command" in
    doctor) print_doctor ;;
    plan) build_plan; print_plan ;;
    verify) print_verify ;;
    apply|update|repair) apply_plan ;;
    uninstall)
      if owns_component system && test "$SYSTEM_STATUS" != normal && test "$SYSTEM_CHOICE_EXPLICIT" -eq 0; then
        if test "$YES" -eq 1; then
          printf 'SYSTEM 已被修改；请用 --keep-system 保留它，或用 --replace-system 恢复安装前版本。\n' >&2
          exit 3
        fi
        if ask_yes 'SYSTEM 已被修改；卸载时恢复安装前版本？选择否将保留它。'; then REPLACE_SYSTEM=1; else KEEP_SYSTEM=1; fi
      fi
      if test "$YES" -ne 1; then ask_yes '卸载受管理配置？外部工具会保留。' || { printf '已取消。\n'; exit 1; }; fi
      acquire_workstation_lock || exit
      if ! workstation_uninstall; then
        release_workstation_lock
        printf '卸载未完成；所有权状态和备份已保留，请修复错误后重试。\n' >&2
        exit 1
      fi
      release_workstation_lock
      if test "$JSON" -eq 1; then printf '{"status":"uninstalled","backups":"%s"}\n' "$BACKUP_HOME"; else printf '已卸载受管理内容；备份保留在 %s。\n' "$BACKUP_HOME"; fi
      ;;
  esac
}

main "$@"
