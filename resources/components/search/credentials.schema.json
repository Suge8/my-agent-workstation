{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-agent-workstation.invalid/schemas/search-credentials.json",
  "title": "Search credential state",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "providers"],
  "properties": {
    "version": { "const": 1 },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brave", "exa", "context7", "bark"],
      "properties": {
        "brave": { "$ref": "#/$defs/restricted" },
        "exa": { "$ref": "#/$defs/restricted" },
        "context7": { "$ref": "#/$defs/oauth" },
        "bark": { "$ref": "#/$defs/restricted" }
      }
    }
  },
  "$defs": {
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "auth"],
      "properties": {
        "enabled": { "type": "boolean" },
        "auth": { "enum": ["missing", "valid", "invalid"] }
      }
    },
    "restricted": { "$ref": "#/$defs/base" },
    "oauth": { "$ref": "#/$defs/base" }
  }
}
