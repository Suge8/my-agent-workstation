{
  "version": 1,
  "models": {
    "sol": {
      "provider": "openai-codex",
      "model": "gpt-5.6-sol"
    },
    "luna": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna"
    },
    "opus": {
      "provider": "anthropic",
      "model": "claude-opus-5"
    },
    "sonnet": {
      "provider": "anthropic",
      "model": "claude-sonnet-5"
    },
    "kimi": {
      "provider": "kimi-coding",
      "model": "k3-256k"
    }
  },
  "default": "sol",
  "cycle": ["sol", "luna", "sonnet", "opus", "kimi"],
  "presets": {
    "sol": { "model": "sol", "thinkingLevel": "medium", "key": "alt+1" },
    "luna": { "model": "luna", "thinkingLevel": "xhigh", "key": "alt+2" },
    "sonnet": { "model": "sonnet", "thinkingLevel": "medium", "key": "alt+3" },
    "opus": { "model": "opus", "thinkingLevel": "medium", "key": "alt+4" },
    "kimi": { "model": "kimi", "thinkingLevel": "high", "key": "alt+5" }
  },
  "master": [
    { "model": "sol", "thinking": "medium", "use": "调研与实现、调试" },
    { "model": "luna", "thinking": "xhigh", "use": "大规模并行快任务" },
    { "model": "opus", "thinking": "medium", "use": "前端与综合架构" },
    { "model": "kimi", "thinking": "high", "use": "视觉设计" }
  ],
  "review": {
    "advisor": { "model": "opus", "thinking": "high" },
    "reviewers": [
      { "model": "sonnet", "thinking": "medium" },
      { "model": "opus", "thinking": "medium" },
      { "model": "sol", "thinking": "medium" }
    ]
  },
  "keybindings": {
    "app.thinking.cycle": "tab",
    "app.model.cycleForward": "shift+tab",
    "app.session.rename": ["ctrl+r", "alt+r"]
  },
  "firecodeKeys": {
    "rename": "ctrl+r",
    "cyclePreset": "ctrl+shift+u",
    "fast": "ctrl+f"
  }
}
