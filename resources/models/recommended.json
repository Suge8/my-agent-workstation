{
  "version": 1,
  "models": {
    "sol": { "provider": "openai-codex", "model": "gpt-5.6-sol" },
    "terra": { "provider": "openai-codex", "model": "gpt-5.6-terra" },
    "luna": { "provider": "openai-codex", "model": "gpt-5.6-luna" },
    "mini": { "provider": "openai-codex", "model": "gpt-5.4-mini" },
    "spark": { "provider": "openai-codex", "model": "gpt-5.3-codex-spark" },
    "fable": { "provider": "anthropic", "model": "claude-fable-5" },
    "sonnet": { "provider": "anthropic", "model": "claude-sonnet-5" },
    "opus5": { "provider": "anthropic", "model": "claude-opus-5" },
    "opus46": { "provider": "anthropic", "model": "claude-opus-4-6" },
    "xai": { "provider": "xai", "model": "grok-4.6" },
    "ds-flash": { "provider": "deepseek", "model": "deepseek-v4-flash" },
    "ds-pro": { "provider": "deepseek", "model": "deepseek-v4-pro" },
    "k3": { "provider": "kimi-coding", "model": "k3" },
    "k3-256": { "provider": "kimi-coding", "model": "k3-256k" },
    "gemini": { "provider": "antigravity", "model": "gemini-3.7-flash" },
    "firecode-default": { "provider": "openai", "model": "gpt-4.1" }
  },
  "default": "sol",
  "cycle": [
    "sol",
    "terra",
    "luna",
    "mini",
    "spark",
    "fable",
    "sonnet",
    "opus5",
    "opus46",
    "xai",
    "ds-flash",
    "ds-pro",
    "k3",
    "k3-256",
    "gemini"
  ],
  "presets": {
    "fable": { "model": "fable", "thinkingLevel": "medium", "key": "alt+1" },
    "opus5": { "model": "opus5", "thinkingLevel": "medium", "key": "alt+2" },
    "sol": { "model": "sol", "thinkingLevel": "medium", "key": "alt+3" },
    "gemini": { "model": "gemini", "thinkingLevel": "high", "key": "alt+4" },
    "ds": { "model": "ds-flash", "thinkingLevel": "high", "key": "alt+5" },
    "k3-256": { "model": "k3-256", "thinkingLevel": "high", "key": "alt+6" },
    "xai": { "model": "xai", "thinkingLevel": "high", "key": "alt+7" }
  },
  "master": [
    { "model": "firecode-default", "thinking": "medium", "use": "通用实现与调试" }
  ],
  "review": {
    "advisor": { "model": "firecode-default", "thinking": "high" },
    "reviewers": [
      { "model": "firecode-default", "thinking": "high" }
    ]
  },
  "keybindings": {
    "app.model.cycleForward": "shift+tab",
    "app.thinking.cycle": "tab",
    "tui.input.tab": [],
    "tui.editor.cursorWordRight": ["alt+right", "ctrl+right"],
    "tui.editor.cursorRight": "right",
    "app.session.rename": "alt+r"
  },
  "firecodeKeys": {
    "rename": "ctrl+r",
    "cyclePreset": "ctrl+shift+u",
    "fast": "ctrl+f"
  }
}
